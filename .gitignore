# ==========================================================
# Monorepo Git Ignore Configuration
# ==========================================================

# Node dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables and secrets
.env
.env.*
*.env
**/.env
**/.env.*
.env.local
.env.*.local
*.pem
*.key

# Whitelist safe environment template files and public production configs
!.env.example
!**/.env.example
!**/frontend/.env.production

# Build outputs
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/

# Editor & OS files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Logs and scratch
*.log
scratch/
